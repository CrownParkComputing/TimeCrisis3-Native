--- a/pcsx2/x86/ix86-32/iR5900.cpp
+++ b/pcsx2/x86/ix86-32/iR5900.cpp
@@ -24,6 +24,9 @@
 
 // Only for MOVQ workaround.
 #include "common/emitter/internal.h"
+#ifdef TC3_ENABLE_NATIVE_BLOCK_PROOF
+#include "pcsx2_block_bridge.h"
+#endif
 
 //#define DUMP_BLOCKS 1
 //#define TRACE_BLOCKS 1
@@ -376,6 +379,19 @@
 	pxAssertMsg(DispatcherReg != NULL, "Please compile the DispatcherReg subroutine *before* JITComple.  Thanks.");
 
 	u8* retval = xGetAlignedCallTarget();
+
+#ifdef TC3_ENABLE_NATIVE_BLOCK_PROOF
+	// A bounded, byte-verified block may run against canonical cpuRegs.
+	// The ordinary JIT remains the fallback for every rejected/unknown PC.
+	xFastCall((const void*)tc3TryNativeBlockProof);
+	xTEST(eax, eax);
+	xForwardJZ32 ordinary_jit;
+	xMOV(rax, ptr64[&cpuRegs.cycle]);
+	xSUB(rax, ptr64[&cpuRegs.nextEventCycle]);
+	xJS(DispatcherReg);
+	xJMP(DispatcherEvent);
+	ordinary_jit.SetTarget();
+#endif
 
 	xFastCall((const void*)recRecompile, ptr32[&cpuRegs.pc]);
 
@@ -604,6 +620,9 @@
 ////////////////////////////////////////////////////
 static void recResetRaw()
 {
+#ifdef TC3_ENABLE_NATIVE_BLOCK_PROOF
+	tc3NativeBlockProofClearBinding(); // Loader must revalidate after reset.
+#endif
 	Console.WriteLn(Color_StrongBlack, "EE/iR5900 Recompiler Reset");
 
 	if (CHECK_EXTRAMEM != extraRam)
